// Ensure backtick (grave) and tilde are proper dead keys in us-intl layout,
// and map both <TLDE> and <LSGT> for compatibility across ANSI and Apple ISO keyboards.
// Unshifted: dead_grave (` + a -> à)
// Shifted: dead_tilde (~ + a -> ã, ~ + o -> õ)
// Level 3 (AltGr): literal grave (`)
// Level 4 (AltGr+Shift): literal asciitilde (~)
partial alphanumeric_keys
xkb_symbols "fixgrave" {
    key <TLDE> { [ dead_grave, dead_tilde, grave, asciitilde ] };
    key <LSGT> { [ dead_grave, dead_tilde, grave, asciitilde ] };
};