#!/bin/bash

# Called by omarchy-hook theme-set with the new theme name as $1.

THEME_NAME="$1"
CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"

# Reload tmux configuration so new theme colors apply immediately
if tmux info &>/dev/null; then
  tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null || true
  tmux refresh-client 2>/dev/null || true
fi

# Sync acpd.toml directly to ~/.config/acpd/config.toml and reload acpd
if [[ -f "$CURRENT_THEME_DIR/acpd.toml" ]]; then
  mkdir -p "$HOME/.config/acpd"
  cp "$CURRENT_THEME_DIR/acpd.toml" "$HOME/.config/acpd/config.toml"
  if systemctl --user is-active --quiet acpd 2>/dev/null; then
    systemctl --user restart acpd 2>/dev/null || true
  else
    pkill -HUP acpd 2>/dev/null || true
  fi
fi

# Clear stale uwsm app-daemon error flag if any
rm -f "/run/user/$UID/uwsm/app_daemon_error"
