#!/bin/bash
# hypr-anim — Simple & fast TUI Hyprland Animation Switcher using matchmaker

set -euo pipefail

ANIM_DIR="$HOME/.config/hypr/animations"
CONFIG_DEST="$HOME/.config/hypr/animations.conf"
PRESET_FILE="$HOME/.config/matchmaker/presets/animations.toml"

MM_BIN=$(command -v mm || echo "$HOME/.local/bin/mm")

run_picker() {
    if [[ ! -x $MM_BIN ]]; then
        command -v notify-send >/dev/null 2>&1 && notify-send "Animation Switcher" "matchmaker binary not found at $MM_BIN"
        exit 1
    fi

    if [[ ! -f $PRESET_FILE ]]; then
        command -v notify-send >/dev/null 2>&1 && notify-send "Animation Switcher" "Preset config file not found at $PRESET_FILE"
        exit 1
    fi

    local selected
    selected=$(cd "$ANIM_DIR" && "$MM_BIN" -o "$PRESET_FILE" 2>/dev/null || true)

    [[ -z "$selected" ]] && exit 0

    # Clean filename
    local filename
    filename=$(echo "$selected" | sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g' | tr -d '\r\n' | xargs -n1 basename)

    local path="$ANIM_DIR/$filename"

    if [[ -f $path ]]; then
        cp "$path" "$CONFIG_DEST"
        hyprctl reload >/dev/null 2>&1

        local title
        title=$(head -n 1 "$path" | sed 's/^# *//')
        [[ -z "$title" ]] && title="$filename"

        if command -v notify-send >/dev/null 2>&1; then
            notify-send -a "Hyprland" -i "preferences-desktop-theme" "Animation Applied" "$title"
        fi
        echo "✨ Animation '$title' applied successfully!"
    fi
}

main() {
    if [[ ${1:-} == "--in-terminal" ]]; then
        run_picker
        exit 0
    fi

    if [[ ! -t 0 || ! -t 1 ]]; then
        local inner="export PATH=$(printf '%q' "$PATH"); $(printf '%q' "${BASH_SOURCE[0]}") --in-terminal"
        if command -v uwsm-app >/dev/null 2>&1; then
            setsid uwsm-app -- xdg-terminal-exec --app-id=hypr-anim-tui --title="Animation Switcher" \
                -e bash -c "$inner" >/dev/null 2>&1 &
        else
            setsid xdg-terminal-exec --app-id=hypr-anim-tui --title="Animation Switcher" \
                -e bash -c "$inner" >/dev/null 2>&1 &
        fi
        exit 0
    fi

    run_picker
}

main "$@"
