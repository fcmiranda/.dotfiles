#!/usr/bin/env bash
set -e

tmp_candidates=$(mktemp "/tmp/mm-ftb-candidates-XXXXXX")
cat > "$tmp_candidates"

if [ ! -s "$tmp_candidates" ]; then
    rm -f "$tmp_candidates"
    exit 0
fi

# Matchmaker: sem ícones, buscando na coluna 2 e devolvendo a linha original {=}
selected=$(mm cmd "cat '$tmp_candidates'" d '\x00' columns.default=2 o '{=}' query.prompt=" Complete > " < /dev/tty 2> /dev/tty || true)
rm -f "$tmp_candidates"

if [ -n "$selected" ]; then
    # Protocolo estrito do fzf-tab (3 linhas: query, expect_key, selected)
    printf "\n\n%s\n" "$selected"
fi
