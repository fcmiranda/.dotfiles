#!/usr/bin/env bash
# Matchmaker backend adapter for fzf-tab (mm-ftb) using ftb preset
# Zero-Fork & Zero-Disk I/O streaming adapter
set -e

# Protocol for fzf-tab: Line 1 (query), Line 2 (expect_key)
# Streamed directly to stdout so null bytes \0 are preserved
printf "\n\n"

# Run Matchmaker directly streaming from stdin
exec mm -o ftb "$@"

